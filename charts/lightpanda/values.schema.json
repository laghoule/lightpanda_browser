{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lightpanda Browser Helm Chart Values",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" },
        "digest": { "type": "string" }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "server": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocols": {
          "type": "array",
          "items": { "type": "string", "enum": ["cdp", "webdriver"] },
          "minItems": 1
        },
        "advertiseHost": { "type": "string" },
        "maxConnections": { "type": "integer", "minimum": 0 },
        "maxPendingConnections": { "type": "integer", "minimum": 0 },
        "maxMessageSize": { "type": "integer", "minimum": 0 },
        "maxHttpMessageSize": { "type": "integer", "minimum": 0 },
        "httpSessionTimeout": { "type": "integer", "minimum": 0 }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error", "fatal"] },
        "logFormat": { "type": "string", "enum": ["logfmt", "json", "pretty"] },
        "obeyRobots": { "type": "boolean" },
        "blockPrivateNetworks": { "type": "boolean" },
        "cors": { "type": "boolean" },
        "loadResources": { "type": "array", "items": { "type": "string" } },
        "watchdogMs": { "type": "integer", "minimum": 0 },
        "httpTimeout": { "type": "integer", "minimum": 0 },
        "httpConnectTimeout": { "type": "integer", "minimum": 0 },
        "httpMaxConcurrent": { "type": "integer", "minimum": 0 },
        "timezone": { "type": "string" },
        "locale": { "type": "string" },
        "userAgent": { "type": "string" },
        "userAgentSuffix": { "type": "string" },
        "v8MaxHeapMb": { "type": "integer", "minimum": 0 },
        "blockUrls": { "type": "array", "items": { "type": "string" } },
        "blockCidrs": { "type": "array", "items": { "type": "string" } },
        "adblockLists": { "type": "array", "items": { "type": "string" } },
        "proxy": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "httpProxy": { "type": "string" },
            "proxyBearerToken": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string" }
          }
        }
      }
    },
    "env": {
      "type": "object",
      "properties": {
        "disableTelemetry": { "type": "boolean" },
        "disableCoreDump": { "type": "boolean" }
      }
    },
    "extraArgs": { "type": "array" },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "tmpVolume": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "sizeLimit": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      }
    },
    "resources": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "startupProbe": { "type": "object" },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "labels": { "type": "object" }
          }
        },
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "additionalLabels": { "type": "object" },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "alert": { "type": "string" },
                  "enabled": { "type": "boolean" },
                  "expr": { "type": "string" },
                  "for": { "type": "string" },
                  "labels": { "type": "object" },
                  "annotations": { "type": "object" }
                },
                "required": ["alert", "expr"]
              }
            },
            "additionalGroups": { "type": "array" }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": { "type": "array" },
        "egress": { "type": "array" }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" }
  },
  "required": ["image", "server"]
}
